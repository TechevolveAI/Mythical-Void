    "validate:gameplay-social-kit": "node scripts/company/validate-authentic-gameplay-social-kit.cjs",
    "test:gameplay-social-kit": "node scripts/company/test-authentic-gameplay-social-kit.cjs",
    "build:creator-kit": "node scripts/company/build-authentic-gameplay-creator-kit.cjs",
    "validate:creator-kit": "node scripts/company/validate-authentic-gameplay-creator-kit.cjs",
    "test:creator-kit": "node scripts/company/test-authentic-gameplay-creator-kit.cjs",
    "validate:first-social-release": "node scripts/company/validate-first-social-release.cjs",
    "test:first-social-release": "node scripts/company/test-first-social-release.cjs",
    "validate:nasa-stem-social-release": "node scripts/company/validate-nasa-stem-social-release.cjs",
    "test:nasa-stem-social-release": "node scripts/company/test-nasa-stem-social-release.cjs",
    "validate:father-son-story-social-release": "node scripts/company/validate-father-son-story-social-release.cjs",
    "test:father-son-story-social-release": "node scripts/company/test-father-son-story-social-release.cjs",
    "validate:social-previews": "node scripts/company/validate-social-preview-metadata.cjs",
    "test:social-previews": "node scripts/company/test-social-preview-metadata.cjs",
    "validate:owned-discovery": "node scripts/company/validate-owned-discovery-release.cjs",
    "test:owned-discovery": "node scripts/company/test-owned-discovery-release.cjs",
    "submit:indexnow": "node scripts/company/submit-indexnow.cjs",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:deploy": "jest --runInBand",
    "test:manual": "node ./scripts/serve-test-framework.js",
    "test:release": "npm test && npm run smoke:release",
    "smoke:supabase-fusion": "node scripts/smoke-fusion-authority.js",
    "smoke:living-portrait": "node scripts/smoke-living-portrait-production.js",
    "smoke:companion-video": "node scripts/smoke-companion-video-production.js",
    "generate:cinematic": "node scripts/generate-cinematic-assets.mjs",
    "smoke:interaction": "SMOKE_MODE=interaction node scripts/smoke-secondary-journeys.js",
    "smoke:creature-field-guide": "SMOKE_MODE=creature-field-guide-page node scripts/smoke-secondary-journeys.js",
    "smoke:first-sanctuary": "SMOKE_MODE=first-sanctuary node scripts/smoke-secondary-journeys.js",
    "smoke:topology": "SMOKE_MODE=traversal-topology node scripts/smoke-secondary-journeys.js",
    "smoke:aurora-route": "SMOKE_MODE=aurora-route-journey node scripts/smoke-secondary-journeys.js",
    "smoke:guardian-handoff": "SMOKE_MODE=guardian-handoff node scripts/smoke-secondary-journeys.js",
    "smoke:state-contract": "SMOKE_MODE=state-contract node scripts/smoke-secondary-journeys.js",
    "smoke:village-ui": "SMOKE_MODE=village-ui node scripts/smoke-secondary-journeys.js",
    "smoke:journeys": "npm run smoke:interaction",
    "smoke:release": "npm run build && node scripts/run-browser-smoke.js",
    "validate-flow": "node scripts/validate-game-flow.js",
    "pre-commit": "npm run validate-flow",
    "health-check": "echo 'Health endpoint not available in static build'",
    "lint": "echo 'Linting not configured - add ESLint for production'"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.110.8",
    "phaser": "^3.90.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.21",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.17",
    "terser": "^5.46.0",
    "vite": "^5.2.0"
  },
  "keywords": [
    "game",
    "phaser",
    "javascript",
    "mythical",
    "creature"
  ],
  "author": "",
  "license": "MIT",
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.21.5",
    "@esbuild/linux-x64": "0.21.5",
    "@rollup/rollup-darwin-arm64": "4.52.0",
    "@rollup/rollup-linux-x64-gnu": "4.52.0",
    "@tailwindcss/oxide-darwin-arm64": "4.1.17",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.17",
    "lightningcss-darwin-arm64": "1.30.2",
    "lightningcss-linux-x64-gnu": "1.30.2"
  }
