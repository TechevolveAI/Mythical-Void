    "validate:signal-log": "node scripts/company/validate-public-signal-log.cjs",
    "test:signal-log": "node scripts/company/test-public-signal-log.cjs",
    "build:signal-feeds": "node scripts/company/build-signal-feeds.cjs",
    "validate:signal-feeds": "node scripts/company/validate-signal-feeds.cjs",
    "test:signal-feeds": "node scripts/company/test-signal-feeds.cjs",
    "build:signal-release-pack": "node scripts/company/build-signal-release-pack.cjs",
    "validate:signal-release-pack": "node scripts/company/validate-signal-release-pack.cjs",
    "test:signal-release-pack": "node scripts/company/test-signal-release-pack.cjs",
    "validate:playable-now": "node scripts/company/validate-playable-now-discovery.cjs",
    "validate:educator-discovery": "node scripts/company/validate-educator-discovery.cjs",
