    "validate:launch-visuals": "node scripts/company/validate-launch-visual-readiness.cjs",
    "gate:launch-visuals": "node scripts/company/validate-launch-visual-readiness.cjs --require-approved",
    "test:launch-visuals": "node scripts/company/test-launch-visual-readiness.cjs",
    "remove:withdrawn-public-media": "node scripts/company/remove-withdrawn-public-media.cjs",
    "test:withdrawn-public-media": "node scripts/company/test-remove-withdrawn-public-media.cjs",
    "validate:owned-sharing": "node scripts/company/validate-owned-sharing-loop.cjs",
    "validate:word-of-mouth": "node scripts/company/validate-word-of-mouth-network.cjs",
    "test:word-of-mouth": "node scripts/company/test-word-of-mouth-network.cjs",
    "validate:bottom-of-funnel": "node scripts/company/validate-bottom-of-funnel-plan.cjs",
    "test:playable-now": "node scripts/company/test-playable-now-discovery.cjs",
    "validate:hatch-reveal": "node scripts/company/validate-hatch-reveal-release.cjs",
    "test:hatch-reveal": "node scripts/company/test-hatch-reveal-release.cjs",
