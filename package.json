    "build:creature-showcase-profiles": "node scripts/company/build-real-creature-showcase-profiles.cjs",
    "capture:creature-showcase": "node scripts/company/capture-real-creature-showcase.cjs",
    "validate:creature-showcase": "node scripts/company/validate-real-creature-showcase.cjs",
