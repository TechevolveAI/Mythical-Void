# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# Development Configuration
NODE_ENV=development
PORT=8080
DEBUG=false

# Game Configuration
GAME_SAVE_PREFIX=mythical_creature_game
AUTO_SAVE_INTERVAL=30000
MAX_SAVE_SLOTS=3

# Security Configuration
ENABLE_API_FEATURES=false
VITE_ENABLE_API_FEATURES=false
VITE_ENABLE_AI_PORTRAITS=false
ENABLE_AI_PORTRAITS=false
VITE_ENABLE_AI_VIDEOS=false
ENABLE_AI_VIDEOS=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# NASA API (optional - for space weather features)
# VITE_NASA_API_KEY=your_nasa_api_key_here

# Supabase cloud saves (optional and player opt-in)
VITE_SUPABASE_URL=https://mkcmdbzcihjgidjuypqe.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional accounts for adults aged 18+. See docs/ADULT_EMAIL_ACCOUNTS.md.
# Firebase web app settings are public identifiers, never Admin credentials.
VITE_ENABLE_ADULT_ACCOUNTS=false
# VITE_FIREBASE_API_KEY=public_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=mythical-void-dev-eu.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=mythical-void-dev-eu
# VITE_FIREBASE_APP_ID=public_firebase_web_app_id
# VITE_ADULT_ACCOUNT_API_URL=https://your-mythical-account-service.run.app/v1/adventures
# Server-side media bridge, enabled only with the matching Google service:
ENABLE_ADULT_ACCOUNTS=false
# ADULT_ACCOUNT_API_URL=https://your-mythical-account-service.run.app/v1/adventures
# Google Cloud Run uses its dedicated service identity, never a downloaded key.
# GOOGLE_CLOUD_PROJECT=mythical-void-dev-eu
# ADULT_ACCOUNT_ALLOWED_ORIGINS=https://your-protected-preview.example
# LEGACY_MEDIA_AUTH_URL=https://mkcmdbzcihjgidjuypqe.supabase.co
# LEGACY_MEDIA_PUBLISHABLE_KEY=existing_public_anonymous_media_key

# Note: AI portrait and short-video generation runs only through protected
# Netlify functions. The recommended video path uses the Netlify-managed Gemini
# gateway and Veo; Replicate remains a server-side fallback. Never use VITE_
# prefixes for provider credentials.
# VIDEO_PROVIDER=auto
# GEMINI_API_KEY=server_only_key
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# REPLICATE_API_TOKEN=server_only_fallback_token
# REPLICATE_VIDEO_MODEL=google/veo-3.1-fast
# The game does NOT use external LLM APIs for creature chat responses.
# All chat responses are pre-written for EU AI Act compliance.
