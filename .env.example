# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# Development Configuration
NODE_ENV=development
PORT=8080
DEBUG=false

# Game Configuration
GAME_SAVE_PREFIX=mythical_creature_game
AUTO_SAVE_INTERVAL=30000
MAX_SAVE_SLOTS=3

# Security Configuration
ENABLE_API_FEATURES=false
VITE_ENABLE_API_FEATURES=false
VITE_ENABLE_AI_PORTRAITS=false
ENABLE_AI_PORTRAITS=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# NASA API (optional - for space weather features)
# VITE_NASA_API_KEY=your_nasa_api_key_here

# Supabase cloud saves (optional and player opt-in)
VITE_SUPABASE_URL=https://mkcmdbzcihjgidjuypqe.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Note: AI Art Generation uses Replicate API configured via Netlify
# environment variables (REPLICATE_API_TOKEN) - see netlify.toml
# The game does NOT use external LLM APIs for creature chat responses.
# All chat responses are pre-written for EU AI Act compliance.
