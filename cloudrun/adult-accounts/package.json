{
  "name": "mythical-void-adult-accounts",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test test/*.test.cjs",
    "test:emulators": "firebase emulators:exec --project demo-mythical-adult --only auth,firestore --config firebase.json \"node --test test/*.test.cjs\"",
    "test:browser": "firebase emulators:exec --project demo-mythical-adult --only auth,firestore --config firebase.json \"node ../../scripts/review/test-adult-firebase-browser.cjs\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "firebase-tools": "15.34.1"
  }
}
