{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-time-and-split-brain.schema.json",
  "title": "Mythical protected trusted-time and split-brain rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceEvidence", "coordinationPolicy", "scenarioPlan", "refusalPlan", "rehearsalStore", "productionConsensusPolicy", "activationGates", "packetCount", "scenarioCount", "concurrentContenderCount", "refusalScenarioCount", "expectedRefusalCount", "configuredProductionConsensusCount", "configuredProductionIdentityCount", "satisfiedActivationGateCount", "timeAndSplitBrainContractReadyForReview", "productionConsensusReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_trusted_time_split_brain_and_fencing_race_rehearsal_ready_production_consensus_gated" },
    "purpose": { "type": "string", "minLength": 700 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "coordinationPolicy": { "type": "object" },
    "scenarioPlan": { "type": "object" },
    "refusalPlan": { "type": "object" },
    "rehearsalStore": { "type": "object" },
    "productionConsensusPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "packetCount": { "const": 2 },
    "scenarioCount": { "const": 10 },
    "concurrentContenderCount": { "const": 12 },
    "refusalScenarioCount": { "const": 16 },
    "expectedRefusalCount": { "const": 16 },
    "configuredProductionConsensusCount": { "const": 0 },
    "configuredProductionIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "timeAndSplitBrainContractReadyForReview": { "const": true },
    "productionConsensusReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 750 }
  },
  "additionalProperties": false
}
