{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/safeguarding-activation.schema.json",
  "title": "Mythical safeguarding activation contract",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "operatingBoundary", "humanCoverage", "responseTargets", "protectedRoutesAndRecords", "professionalReview", "currentSyntheticEvidence", "requiredExercises", "activationGates", "downstreamDependencies", "kevinInputBrief", "inputBriefReadyForKevinReview", "providedKevinInputCount", "satisfiedActivationGateCount", "passedExerciseCount", "readyDownstreamDependencyCount", "coverageReady", "restrictedRoutingTestReady", "supportPilotReady", "researchSafeguardingGateReady", "publicIntakePromotionReady", "activationReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "activation_contract_ready_human_coverage_gated" },
    "purpose": { "type": "string", "minLength": 80 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "operatingBoundary": { "type": "object" },
    "humanCoverage": { "type": "object" },
    "responseTargets": { "type": "object" },
    "protectedRoutesAndRecords": { "type": "object" },
    "professionalReview": { "type": "object" },
    "currentSyntheticEvidence": { "type": "object" },
    "requiredExercises": { "type": "array", "minItems": 10, "maxItems": 10 },
    "activationGates": { "type": "array", "minItems": 16, "maxItems": 16 },
    "downstreamDependencies": { "type": "array", "minItems": 5, "maxItems": 5 },
    "kevinInputBrief": { "type": "array", "minItems": 5, "maxItems": 5 },
    "inputBriefReadyForKevinReview": { "const": true },
    "providedKevinInputCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "passedExerciseCount": { "const": 0 },
    "readyDownstreamDependencyCount": { "const": 0 },
    "coverageReady": { "const": false },
    "restrictedRoutingTestReady": { "const": false },
    "supportPilotReady": { "const": false },
    "researchSafeguardingGateReady": { "const": false },
    "publicIntakePromotionReady": { "const": false },
    "activationReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 100 }
  },
  "additionalProperties": false
}
