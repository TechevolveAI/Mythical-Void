{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/shadow-runtime.schema.json",
  "title": "Mythical internal agent shadow-runtime contract",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "authority", "runtime", "roles", "steps", "recordPolicy", "promotionEvidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "local_single_process_rehearsal" },
    "purpose": { "type": "string", "minLength": 30 },
    "authority": {
      "type": "object",
      "additionalProperties": { "const": false }
    },
    "runtime": {
      "type": "object",
      "required": ["singleProcessRehearsal", "schedulerConfigured", "isolatedServiceIdentitiesConfigured", "protectedHistoryStoreConfigured", "authenticatedAlertRouteConfigured", "trustedApprovalVerifierConfigured", "killSwitchExercisePassed", "cycleRecordPersistenceEnabled", "connectedCredentialIds", "commandTimeoutMs", "maximumSteps"]
    },
    "roles": {
      "type": "object",
      "required": ["orchestratorAgentId", "assuranceAgentId", "accountableHuman", "ownerConfirmationRecorded", "backupHuman", "urgentExceptionRecipient"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "workflowId", "primaryAgentId", "evaluatorAgentId", "command", "expectedExitCodes", "output", "mayWrite", "mayUseCredentials", "mayReadRestrictedData", "mayCauseExternalAction"]
      }
    },
    "recordPolicy": { "type": "object" },
    "promotionEvidence": { "type": "object" }
  },
  "additionalProperties": false
}
