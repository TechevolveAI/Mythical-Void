{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-runtime-provider-evaluation.schema.json",
  "title": "Mythical protected-runtime provider evaluation",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "architectureClassRef", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourcePolicy", "platformCapabilityRequirements", "sources", "candidates", "recommendedNextReviewCandidateId", "recommendationIsProviderSelection", "selectedProviderId", "reviewPackageReady", "deploymentReady", "runtimePromotionEligible", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "provider_shortlist_complete_selection_gated" },
    "purpose": { "type": "string", "minLength": 50 },
    "architectureClassRef": { "const": "PR-001" },
    "decisionRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "riskRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "workflowRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourcePolicy": { "type": "object" },
    "platformCapabilityRequirements": { "type": "array", "minItems": 12, "maxItems": 12 },
    "sources": { "type": "array", "minItems": 1 },
    "candidates": { "type": "array", "minItems": 3, "maxItems": 3 },
    "recommendedNextReviewCandidateId": { "type": "string" },
    "recommendationIsProviderSelection": { "const": false },
    "selectedProviderId": { "type": "null" },
    "reviewPackageReady": { "const": true },
    "deploymentReady": { "const": false },
    "runtimePromotionEligible": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 50 }
  },
  "additionalProperties": false
}
