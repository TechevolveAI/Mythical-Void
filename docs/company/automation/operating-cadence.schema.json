{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/operating-cadence.schema.json",
  "title": "Mythical bounded company operating cadence",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "people", "clockPolicy", "resourceEnvelope", "calendarSchedules", "eventTriggerPlans", "idempotencyAndOverlap", "staleAndFailurePolicy", "historyAndAlerts", "referenceSimulation", "activationGates", "kevinInputBrief", "inputBriefReadyForKevinReview", "providedKevinInputCount", "calendarScheduleCount", "enabledCalendarScheduleCount", "eventTriggerPlanCount", "enabledEventTriggerCount", "satisfiedActivationGateCount", "schedulerConfigured", "schedulerEnabled", "simulationValid", "protectedHistoryReady", "authenticatedAlertingReady", "cadenceActivationReady", "runtimePromotionEligible", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "cadence_contract_ready_scheduler_gated" },
    "purpose": { "type": "string", "minLength": 100 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "people": { "type": "object" },
    "clockPolicy": { "type": "object" },
    "resourceEnvelope": { "type": "object" },
    "calendarSchedules": { "type": "array", "minItems": 4, "maxItems": 4 },
    "eventTriggerPlans": { "type": "array", "minItems": 4, "maxItems": 4 },
    "idempotencyAndOverlap": { "type": "object" },
    "staleAndFailurePolicy": { "type": "object" },
    "historyAndAlerts": { "type": "object" },
    "referenceSimulation": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "kevinInputBrief": { "type": "array", "minItems": 5, "maxItems": 5 },
    "inputBriefReadyForKevinReview": { "const": true },
    "providedKevinInputCount": { "const": 0 },
    "calendarScheduleCount": { "const": 4 },
    "enabledCalendarScheduleCount": { "const": 0 },
    "eventTriggerPlanCount": { "const": 4 },
    "enabledEventTriggerCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "schedulerConfigured": { "const": false },
    "schedulerEnabled": { "const": false },
    "simulationValid": { "const": true },
    "protectedHistoryReady": { "const": false },
    "authenticatedAlertingReady": { "const": false },
    "cadenceActivationReady": { "const": false },
    "runtimePromotionEligible": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 120 }
  },
  "additionalProperties": false
}
