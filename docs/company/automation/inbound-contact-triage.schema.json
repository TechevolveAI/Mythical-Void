{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/schemas/inbound-contact-triage.schema.json",
  "title": "Mythical inbound contact triage contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "status",
    "purpose",
    "decisionRefs",
    "riskRefs",
    "workflowRefs",
    "authority",
    "inputBoundary",
    "operatingRules",
    "categories",
    "syntheticCases",
    "expectedResults",
    "productionReadiness",
    "activationGates",
    "inboundTriageReadyForReview",
    "liveInboxReady",
    "humanReviewRequired",
    "externalActionAuthorized",
    "nextDecision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_inbound_contact_triage_ready_human_review_required" },
    "purpose": { "type": "string", "minLength": 500 },
    "decisionRefs": { "type": "array", "items": { "type": "string", "pattern": "^D-[0-9]{3}$" }, "uniqueItems": true },
    "riskRefs": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9]{3}$" }, "uniqueItems": true },
    "workflowRefs": { "type": "array", "items": { "type": "string", "pattern": "^A-[0-9]{3}$" }, "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "categories": { "type": "array", "minItems": 10, "maxItems": 10 },
    "syntheticCases": { "type": "array", "minItems": 12, "maxItems": 12 },
    "activationGates": { "type": "array", "minItems": 14, "maxItems": 14 },
    "inboundTriageReadyForReview": { "const": true },
    "liveInboxReady": { "const": false },
    "humanReviewRequired": { "const": true },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 500 }
  },
  "additionalProperties": false
}
