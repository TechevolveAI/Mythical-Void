{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-backup-and-restore.schema.json",
  "title": "Mythical protected backup, restore, and disaster-recovery rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceEvidence", "backupPolicy", "scenarioPlan", "refusalPlan", "rehearsalStore", "productionDurabilityPolicy", "activationGates", "packetCount", "evidenceRecordCount", "scenarioCount", "restoreContenderCount", "refusalScenarioCount", "expectedRefusalCount", "configuredProductionDurabilityCount", "configuredProductionIdentityCount", "satisfiedActivationGateCount", "backupRestoreContractReadyForReview", "productionDurabilityReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_payload_free_backup_restore_and_disaster_recovery_rehearsal_ready_production_durability_gated" },
    "purpose": { "type": "string", "minLength": 750 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "backupPolicy": { "type": "object" },
    "scenarioPlan": { "type": "object" },
    "refusalPlan": { "type": "object" },
    "rehearsalStore": { "type": "object" },
    "productionDurabilityPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "packetCount": { "const": 2 },
    "evidenceRecordCount": { "const": 6 },
    "scenarioCount": { "const": 10 },
    "restoreContenderCount": { "const": 4 },
    "refusalScenarioCount": { "const": 17 },
    "expectedRefusalCount": { "const": 17 },
    "configuredProductionDurabilityCount": { "const": 0 },
    "configuredProductionIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "backupRestoreContractReadyForReview": { "const": true },
    "productionDurabilityReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 850 }
  },
  "additionalProperties": false
}
