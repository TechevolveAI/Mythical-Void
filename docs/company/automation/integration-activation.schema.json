{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/integration-activation.schema.json",
  "title": "Mythical least-privilege integration activation register",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "authority", "rules", "integrations", "sequence", "firstKevinAccessBrief", "inventoryComplete", "newActivationReady", "externalActionAuthorized"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "inventory_complete_activation_gated" },
    "purpose": { "type": "string", "minLength": 50 },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "rules": { "type": "object" },
    "integrations": { "type": "array", "minItems": 1 },
    "sequence": { "type": "array", "minItems": 1 },
    "firstKevinAccessBrief": { "type": "object" },
    "inventoryComplete": { "const": true },
    "newActivationReady": { "const": false },
    "externalActionAuthorized": { "const": false }
  },
  "additionalProperties": false
}
