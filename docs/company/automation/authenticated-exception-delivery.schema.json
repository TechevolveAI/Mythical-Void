{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/authenticated-exception-delivery.schema.json",
  "title": "Mythical authenticated exception-delivery rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "integrationRef", "authority", "sourceEvidence", "alertPolicy", "syntheticRoutes", "rehearsalPlan", "refusalPlan", "rehearsalStore", "productionDeliveryPolicy", "activationGates", "syntheticRouteCount", "refusalScenarioCount", "expectedRefusalCount", "configuredProductionRouteCount", "configuredProductionIdentityCount", "satisfiedActivationGateCount", "deliveryContractReadyForReview", "productionDeliveryReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_authenticated_exception_delivery_rehearsal_ready_production_routes_gated" },
    "purpose": { "type": "string", "minLength": 400 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "integrationRef": { "const": "IC-011" },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "alertPolicy": { "type": "object" },
    "syntheticRoutes": { "type": "array", "minItems": 2, "maxItems": 2 },
    "rehearsalPlan": { "type": "object" },
    "refusalPlan": { "type": "object" },
    "rehearsalStore": { "type": "object" },
    "productionDeliveryPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "syntheticRouteCount": { "const": 2 },
    "refusalScenarioCount": { "const": 16 },
    "expectedRefusalCount": { "const": 16 },
    "configuredProductionRouteCount": { "const": 0 },
    "configuredProductionIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "deliveryContractReadyForReview": { "const": true },
    "productionDeliveryReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 450 }
  },
  "additionalProperties": false
}
