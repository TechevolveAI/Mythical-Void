{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/pe001-public-due-diligence.schema.json",
  "title": "Mythical PE-001 public due diligence",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "candidateId", "architectureClassRef", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourcePolicy", "sources", "publicRequirementAssessments", "regionalAndPrivacyReview", "costReview", "disabledReferenceBlueprint", "accountAndHumanGates", "publicReviewOutcome", "publicBlockerCount", "documentedPlausibleRequirementCount", "partialPublicEvidenceRequirementCount", "configurationVerifiedRequirementCount", "satisfiedAccountAndHumanGateCount", "providerSelected", "accountScopedReviewReady", "deploymentReady", "runtimePromotionEligible", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "public_due_diligence_complete_account_review_gated" },
    "purpose": { "type": "string", "minLength": 50 },
    "candidateId": { "const": "PE-001" },
    "architectureClassRef": { "const": "PR-001" },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourcePolicy": { "type": "object" },
    "sources": { "type": "array", "minItems": 17, "maxItems": 17 },
    "publicRequirementAssessments": { "type": "array", "minItems": 12, "maxItems": 12 },
    "regionalAndPrivacyReview": { "type": "object" },
    "costReview": { "type": "object" },
    "disabledReferenceBlueprint": { "type": "object" },
    "accountAndHumanGates": { "type": "array", "minItems": 14, "maxItems": 14 },
    "publicReviewOutcome": { "const": "conditional_pass_for_account_scoped_review_only" },
    "publicBlockerCount": { "const": 0 },
    "documentedPlausibleRequirementCount": { "const": 7 },
    "partialPublicEvidenceRequirementCount": { "const": 5 },
    "configurationVerifiedRequirementCount": { "const": 0 },
    "satisfiedAccountAndHumanGateCount": { "const": 0 },
    "providerSelected": { "const": false },
    "accountScopedReviewReady": { "const": false },
    "deploymentReady": { "const": false },
    "runtimePromotionEligible": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 50 }
  },
  "additionalProperties": false
}
