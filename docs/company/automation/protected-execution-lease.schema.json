{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-execution-lease.schema.json",
  "title": "Mythical protected execution lease, fencing, and kill rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceEvidence", "leasePolicy", "rehearsalPlan", "killRehearsal", "refusalPlan", "rehearsalStore", "productionCoordinatorPolicy", "activationGates", "packetCount", "operationCount", "refusalScenarioCount", "expectedRefusalCount", "configuredProductionCoordinatorCount", "configuredProductionIdentityCount", "satisfiedActivationGateCount", "leaseContractReadyForReview", "productionCoordinationReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_execution_lease_fencing_and_kill_rehearsal_ready_production_coordinator_gated" },
    "purpose": { "type": "string", "minLength": 450 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "leasePolicy": { "type": "object" },
    "rehearsalPlan": { "type": "object" },
    "killRehearsal": { "type": "object" },
    "refusalPlan": { "type": "object" },
    "rehearsalStore": { "type": "object" },
    "productionCoordinatorPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "packetCount": { "const": 2 },
    "operationCount": { "const": 11 },
    "refusalScenarioCount": { "const": 12 },
    "expectedRefusalCount": { "const": 12 },
    "configuredProductionCoordinatorCount": { "const": 0 },
    "configuredProductionIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "leaseContractReadyForReview": { "const": true },
    "productionCoordinationReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 500 }
  },
  "additionalProperties": false
}
