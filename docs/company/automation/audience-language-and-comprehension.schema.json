{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/audience-language-and-comprehension.schema.json",
  "title": "Mythical audience language and comprehension preflight",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceBindings", "audienceProfiles", "plainLanguagePolicy", "referenceExamples", "adversarialPlan", "auditExpectations", "productionReviewPolicy", "activationGates", "sourceCount", "audienceProfileCount", "referenceExampleCount", "adversarialScenarioCount", "satisfiedActivationGateCount", "audienceLanguageContractReadyForReview", "currentSourceAuditReady", "humanReviewRequired", "publicationReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_audience_language_and_comprehension_preflight_ready_human_review_required" },
    "purpose": { "type": "string", "minLength": 700 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceBindings": { "type": "array", "minItems": 7, "maxItems": 7 },
    "audienceProfiles": { "type": "array", "minItems": 5, "maxItems": 5 },
    "plainLanguagePolicy": { "type": "object" },
    "referenceExamples": { "type": "array", "minItems": 5, "maxItems": 5 },
    "adversarialPlan": { "type": "object" },
    "auditExpectations": { "type": "object" },
    "productionReviewPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 14, "maxItems": 14 },
    "sourceCount": { "const": 7 },
    "audienceProfileCount": { "const": 5 },
    "referenceExampleCount": { "const": 5 },
    "adversarialScenarioCount": { "const": 12 },
    "satisfiedActivationGateCount": { "const": 0 },
    "audienceLanguageContractReadyForReview": { "const": true },
    "currentSourceAuditReady": { "const": true },
    "humanReviewRequired": { "const": true },
    "publicationReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 700 }
  },
  "additionalProperties": false
}
