{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-failure-recovery.schema.json",
  "title": "Mythical protected failure injection and recovery reconciliation",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceEvidence", "recoveryPolicy", "scenarioPlan", "killRehearsal", "refusalPlan", "rehearsalStore", "productionResiliencePolicy", "activationGates", "packetCount", "scenarioCount", "realCrashCount", "refusalScenarioCount", "expectedRefusalCount", "configuredProductionResilienceCount", "configuredProductionIdentityCount", "satisfiedActivationGateCount", "failureRecoveryContractReadyForReview", "productionResilienceReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_failure_injection_and_recovery_reconciliation_ready_production_resilience_gated" },
    "purpose": { "type": "string", "minLength": 600 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "recoveryPolicy": { "type": "object" },
    "scenarioPlan": { "type": "object" },
    "killRehearsal": { "type": "object" },
    "refusalPlan": { "type": "object" },
    "rehearsalStore": { "type": "object" },
    "productionResiliencePolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "packetCount": { "const": 2 },
    "scenarioCount": { "const": 9 },
    "realCrashCount": { "const": 4 },
    "refusalScenarioCount": { "const": 15 },
    "expectedRefusalCount": { "const": 15 },
    "configuredProductionResilienceCount": { "const": 0 },
    "configuredProductionIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "failureRecoveryContractReadyForReview": { "const": true },
    "productionResilienceReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 600 }
  },
  "additionalProperties": false
}
