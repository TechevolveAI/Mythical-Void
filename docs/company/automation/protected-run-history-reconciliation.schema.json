{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-run-history-reconciliation.schema.json",
  "title": "Mythical protected run-history reconciliation rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "sourceEvidence", "recordPolicy", "eventPlan", "rehearsalStore", "reconciliationPolicy", "tamperPlan", "productionHistoryPolicy", "activationGates", "recordCount", "branchCount", "tamperScenarioCount", "expectedTamperDetectionCount", "configuredProductionHistoryStoreCount", "configuredProductionHistoryIdentityCount", "satisfiedActivationGateCount", "historyContractReadyForReview", "productionHistoryReady", "eligibleCycleReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_tamper_evident_history_rehearsal_ready_production_store_gated" },
    "purpose": { "type": "string", "minLength": 300 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "sourceEvidence": { "type": "object" },
    "recordPolicy": { "type": "object" },
    "eventPlan": { "type": "array", "minItems": 8, "maxItems": 8 },
    "rehearsalStore": { "type": "object" },
    "reconciliationPolicy": { "type": "object" },
    "tamperPlan": { "type": "object" },
    "productionHistoryPolicy": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "recordCount": { "const": 8 },
    "branchCount": { "const": 2 },
    "tamperScenarioCount": { "const": 12 },
    "expectedTamperDetectionCount": { "const": 12 },
    "configuredProductionHistoryStoreCount": { "const": 0 },
    "configuredProductionHistoryIdentityCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "historyContractReadyForReview": { "const": true },
    "productionHistoryReady": { "const": false },
    "eligibleCycleReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 350 }
  },
  "additionalProperties": false
}
