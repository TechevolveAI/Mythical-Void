{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/schemas/website-analytics-tag.schema.json",
  "title": "Mythical public website analytics tag contract",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "tag", "authority", "productionEvidence", "sourceChecks", "prohibitedData", "activationGates", "tagImplementationReadyForReview", "productionDeployed", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "consent_gated_public_shop_window_tag_live_property_verification_pending" },
    "purpose": { "type": "string", "minLength": 500 },
    "decisionRefs": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
    "riskRefs": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
    "workflowRefs": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4 },
    "tag": { "type": "object" },
    "authority": { "type": "object" },
    "sourceChecks": { "type": "array", "minItems": 6, "maxItems": 6 },
    "prohibitedData": { "type": "array", "minItems": 15 },
    "activationGates": { "type": "array", "minItems": 12, "maxItems": 12 },
    "tagImplementationReadyForReview": { "const": true },
    "productionEvidence": {
      "type": "object",
      "required": ["checkedOn", "productionUrl", "verifiedSourceCommit", "verifiedDeployId", "deployState", "homepageTagScriptObserved", "homepageTagScriptUrl", "gameRuntimeTagScriptObserved", "privacyAnalyticsWordingObserved", "freshBrowserConsentJourneyVerified", "googlePropertyEventsVerified", "measurementTrustedForDecisions", "limitation"],
      "properties": {
        "checkedOn": { "const": "2026-08-31" },
        "productionUrl": { "const": "https://mythicalvoid.com/" },
        "verifiedSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "verifiedDeployId": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "deployState": { "const": "ready" },
        "homepageTagScriptObserved": { "const": true },
        "homepageTagScriptUrl": { "const": "https://www.googletagmanager.com/gtag/js?id=G-FTM4W73ECQ" },
        "gameRuntimeTagScriptObserved": { "const": false },
        "privacyAnalyticsWordingObserved": { "const": true },
        "freshBrowserConsentJourneyVerified": { "const": false },
        "googlePropertyEventsVerified": { "const": false },
        "measurementTrustedForDecisions": { "const": false },
        "limitation": { "type": "string", "minLength": 250 }
      },
      "additionalProperties": false
    },
    "productionDeployed": { "const": true },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 500 }
  },
  "additionalProperties": false
}
