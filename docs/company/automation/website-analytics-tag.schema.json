{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/schemas/website-analytics-tag.schema.json",
  "title": "Mythical public website analytics contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "asOf",
    "status",
    "purpose",
    "decisionRefs",
    "riskRefs",
    "workflowRefs",
    "tag",
    "publicActions",
    "authority",
    "sourceChecks",
    "prohibitedData",
    "activationGates",
    "reportingTrustGates",
    "productionDeployed",
    "upgradeReleaseState",
    "trustedForCompanyReporting",
    "nextDecision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "consent_gated_public_website_measurement_live_source_verified" },
    "purpose": { "type": "string", "minLength": 500 },
    "decisionRefs": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
    "riskRefs": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
    "workflowRefs": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
    "tag": { "type": "object" },
    "publicActions": { "type": "object" },
    "authority": { "type": "object" },
    "sourceChecks": { "type": "array", "minItems": 7, "maxItems": 7 },
    "prohibitedData": { "type": "array", "minItems": 20 },
    "activationGates": { "type": "array", "minItems": 12, "maxItems": 12 },
    "reportingTrustGates": { "type": "object" },
    "productionDeployed": { "const": true },
    "upgradeReleaseState": { "enum": ["prepared_on_feature_branch_not_yet_deployed", "deployed_pending_live_verification"] },
    "trustedForCompanyReporting": { "const": false },
    "nextDecision": { "type": "string", "minLength": 500 }
  },
  "additionalProperties": false
}
