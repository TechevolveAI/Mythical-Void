{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-runtime.schema.json",
  "title": "Mythical protected internal runtime architecture",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "scope", "people", "identity", "execution", "history", "alerts", "approvalVerification", "secrets", "resources", "killSwitch", "failureTests", "architectureOptions", "selectedArchitectureOptionId", "readinessGates", "architecturePackageReady", "deploymentReady", "runtimePromotionEligible"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "architecture_package_ready_selection_gated" },
    "purpose": { "type": "string", "minLength": 30 },
    "decisionRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "riskRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "workflowRefs": { "type": "array", "minItems": 1, "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "scope": { "type": "object" },
    "people": { "type": "object" },
    "identity": { "type": "object" },
    "execution": { "type": "object" },
    "history": { "type": "object" },
    "alerts": { "type": "object" },
    "approvalVerification": { "type": "object" },
    "secrets": { "type": "object" },
    "resources": { "type": "object" },
    "killSwitch": { "type": "object" },
    "failureTests": { "type": "object" },
    "architectureOptions": { "type": "array", "minItems": 3, "maxItems": 3 },
    "selectedArchitectureOptionId": { "type": ["string", "null"] },
    "readinessGates": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "architecturePackageReady": { "type": "boolean" },
    "deploymentReady": { "type": "boolean" },
    "runtimePromotionEligible": { "type": "boolean" }
  },
  "additionalProperties": false
}
