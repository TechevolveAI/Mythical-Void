{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-trigger-binding.schema.json",
  "title": "Mythical protected trigger payload binding rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "bindingDesign", "consumers", "syntheticScenarios", "rehearsalAssertions", "activationGates", "consumerCount", "syntheticScenarioCount", "configuredBindingCount", "configuredReplayStoreCount", "configuredHistoryStoreCount", "satisfiedActivationGateCount", "bindingContractReadyForReview", "runtimeBindingReady", "packetExecutionReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_synthetic_binding_rehearsal_ready_live_binding_gated" },
    "purpose": { "type": "string", "minLength": 180 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "bindingDesign": { "type": "object" },
    "consumers": { "type": "array", "minItems": 2, "maxItems": 2 },
    "syntheticScenarios": { "type": "array", "minItems": 2, "maxItems": 2 },
    "rehearsalAssertions": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 14, "maxItems": 14 },
    "consumerCount": { "const": 2 },
    "syntheticScenarioCount": { "const": 2 },
    "configuredBindingCount": { "const": 0 },
    "configuredReplayStoreCount": { "const": 0 },
    "configuredHistoryStoreCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "bindingContractReadyForReview": { "const": true },
    "runtimeBindingReady": { "const": false },
    "packetExecutionReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 220 }
  },
  "additionalProperties": false
}
