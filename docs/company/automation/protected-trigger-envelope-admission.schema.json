{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/protected-trigger-envelope-admission.schema.json",
  "title": "Mythical protected trigger envelope admission rehearsal",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "packetBinding", "cryptographicPolicy", "timePolicy", "payloadPolicy", "replayPolicy", "loggingPolicy", "rehearsalPlan", "activationGates", "consumerCount", "admissionAttemptCount", "expectedAcceptedCount", "expectedRejectedCount", "configuredProductionIdentityCount", "configuredTrustStoreCount", "configuredDurableReplayStoreCount", "configuredProtectedHistoryCount", "satisfiedActivationGateCount", "admissionContractReadyForReview", "productionAdmissionReady", "consumerInvocationReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "offline_cryptographic_admission_rehearsal_ready_live_trust_gated" },
    "purpose": { "type": "string", "minLength": 260 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "packetBinding": { "type": "object" },
    "cryptographicPolicy": { "type": "object" },
    "timePolicy": { "type": "object" },
    "payloadPolicy": { "type": "object" },
    "replayPolicy": { "type": "object" },
    "loggingPolicy": { "type": "object" },
    "rehearsalPlan": { "type": "object" },
    "activationGates": { "type": "array", "minItems": 16, "maxItems": 16 },
    "consumerCount": { "const": 2 },
    "admissionAttemptCount": { "const": 14 },
    "expectedAcceptedCount": { "const": 2 },
    "expectedRejectedCount": { "const": 12 },
    "configuredProductionIdentityCount": { "const": 0 },
    "configuredTrustStoreCount": { "const": 0 },
    "configuredDurableReplayStoreCount": { "const": 0 },
    "configuredProtectedHistoryCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "admissionContractReadyForReview": { "const": true },
    "productionAdmissionReady": { "const": false },
    "consumerInvocationReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 300 }
  },
  "additionalProperties": false
}
