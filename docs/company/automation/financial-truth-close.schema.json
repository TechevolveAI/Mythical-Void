{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/financial-truth-close.schema.json",
  "title": "Mythical restricted financial truth and close contract",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "decisionRefs", "riskRefs", "workflowRefs", "authority", "dataBoundary", "humanRoles", "restrictedSourceClasses", "baselineEvidenceClasses", "closeCalendar", "reconciliationControls", "currentModelEvidence", "requiredExercises", "activationGates", "reviewedCloseCycles", "kevinInputBrief", "inputBriefReadyForKevinReview", "providedKevinInputCount", "connectedRestrictedSourceCount", "reconciledBaselineEvidenceCount", "passedExerciseCount", "satisfiedActivationGateCount", "reviewedCloseCycleCount", "requiredReviewedCloseCycleCount", "restrictedReadReviewReady", "financialBaselineReady", "runwayCalculationReady", "unitEconomicsReady", "forecastPublicationReady", "spendPolicyReady", "monetizationDecisionReady", "activationReady", "externalActionAuthorized", "nextDecision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "close_contract_ready_restricted_actuals_gated" },
    "purpose": { "type": "string", "minLength": 100 },
    "decisionRefs": { "type": "array", "uniqueItems": true },
    "riskRefs": { "type": "array", "uniqueItems": true },
    "workflowRefs": { "type": "array", "uniqueItems": true },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "dataBoundary": { "type": "object" },
    "humanRoles": { "type": "object" },
    "restrictedSourceClasses": { "type": "array", "minItems": 6, "maxItems": 6 },
    "baselineEvidenceClasses": { "type": "array", "minItems": 12, "maxItems": 12 },
    "closeCalendar": { "type": "object" },
    "reconciliationControls": { "type": "object" },
    "currentModelEvidence": { "type": "object" },
    "requiredExercises": { "type": "array", "minItems": 10, "maxItems": 10 },
    "activationGates": { "type": "array", "minItems": 18, "maxItems": 18 },
    "reviewedCloseCycles": { "type": "array", "maxItems": 0 },
    "kevinInputBrief": { "type": "array", "minItems": 5, "maxItems": 5 },
    "inputBriefReadyForKevinReview": { "const": true },
    "providedKevinInputCount": { "const": 0 },
    "connectedRestrictedSourceCount": { "const": 0 },
    "reconciledBaselineEvidenceCount": { "const": 0 },
    "passedExerciseCount": { "const": 0 },
    "satisfiedActivationGateCount": { "const": 0 },
    "reviewedCloseCycleCount": { "const": 0 },
    "requiredReviewedCloseCycleCount": { "const": 4 },
    "restrictedReadReviewReady": { "const": false },
    "financialBaselineReady": { "const": false },
    "runwayCalculationReady": { "const": false },
    "unitEconomicsReady": { "const": false },
    "forecastPublicationReady": { "const": false },
    "spendPolicyReady": { "const": false },
    "monetizationDecisionReady": { "const": false },
    "activationReady": { "const": false },
    "externalActionAuthorized": { "const": false },
    "nextDecision": { "type": "string", "minLength": 120 }
  },
  "additionalProperties": false
}
