{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/commercial-qualification.schema.json",
  "title": "Mythical commercial qualification and deal-desk register",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "purpose", "authority", "model", "portfolioRecommendation", "assessments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "internal_assessment_ready_external_gated" },
    "purpose": { "type": "string", "minLength": 30 },
    "authority": { "type": "object", "additionalProperties": { "const": false } },
    "model": { "type": "object" },
    "portfolioRecommendation": { "type": "string", "minLength": 30 },
    "assessments": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
