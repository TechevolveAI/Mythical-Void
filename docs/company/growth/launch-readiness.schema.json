{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythicalvoid.com/company/schemas/launch-readiness.schema.json",
  "title": "Mythical launch readiness plan",
  "type": "object",
  "required": ["schemaVersion", "asOf", "status", "currentStageId", "authority", "principles", "tracks", "stages", "nextAdmissibleWork"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "status": { "const": "foundation_gated" },
    "currentStageId": { "pattern": "^LS-[0-9]{3}$" },
    "authority": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "principles": { "type": "object" },
    "tracks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "ready", "owner", "workflowRefs", "decisionRefs", "riskRefs", "proofIds", "channelIds", "experimentRefs", "opportunityRefs", "handoffRefs", "blockers", "exitEvidence"]
      }
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "order", "name", "state", "ready", "authorized", "requiredTrackIds", "requiredPriorStageIds", "decisionRefs", "riskRefs", "proofIds", "channelIds", "experimentRefs", "opportunityRefs", "handoffRefs", "workflowRefs", "blockers", "successEvidence"]
      }
    },
    "nextAdmissibleWork": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
