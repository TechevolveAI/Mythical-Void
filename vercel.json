{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/press/gameplay/:path*", "destination": "/press/", "permanent": false },
    { "source": "/press/gameplay-video/:path*", "destination": "/press/", "permanent": false },
    { "source": "/press/social/:path*", "destination": "/press/", "permanent": false },
    { "source": "/press/social-video/:path*", "destination": "/press/", "permanent": false },
    { "source": "/press/creator-kit/:path*", "destination": "/press/", "permanent": false },
    { "source": "/resources/mythical-void-play-share-card.pdf", "destination": "/press/", "permanent": false },
    { "source": "/resources/previews/play-share-card.png", "destination": "/press/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/story",
      "destination": "/story/index.html"
    },
    {
      "source": "/story/",
      "destination": "/story/index.html"
    },
    {
      "source": "/playable-now",
      "destination": "/playable-now/index.html"
    },
    {
      "source": "/playable-now/",
      "destination": "/playable-now/index.html"
    },
    {
      "source": "/updates",
      "destination": "/updates/index.html"
    },
    {
      "source": "/updates/",
      "destination": "/updates/index.html"
    },
    {
      "source": "/((?!assets/|marketing/|game/|audio/|updates/|playable-now/|og\\.png|sw\\.js|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/updates/feed.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/updates/feed.json",
      "headers": [
        { "key": "Content-Type", "value": "application/feed+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.nasa.gov https://apod.nasa.gov https://mars.nasa.gov https://replicate.delivery https://*.replicate.delivery https://www.google-analytics.com; connect-src 'self' https://mkcmdbzcihjgidjuypqe.supabase.co https://api.x.ai https://api.nasa.gov https://api.replicate.com https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
